        saved:     { badge: "FAVOURITES &amp; RECENT", title: "Saved Foods", sub: "1-tap access to your daily foods", s1: "4", l1: "Favourites", s2: "6", l2: "Recent", s3: "264", l3: "Total foods", r1t: "★ Paneer · 265 kcal / 100 g", r1s: "18.3 g protein · 480 mg calcium", r2t: "★ Anda (Egg) · 155 kcal / 100 g", r2s: "12.6 g protein · Vitamin B12 &amp; D", r3t: "★ Kela (Banana) · 89 kcal / 100 g", r3s: "Instant energy · 358 mg potassium", cta: "Saved food kholein", water: false },
