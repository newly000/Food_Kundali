      };

      var state = { food: FOODS.banana, grams: 200, customOpen: false, detailOn: false, fav: false, lang: "hi", dark: false, water: 1500, catOpen: false, moreOpen: false };
      var $ = function(id) { return document.getElementById(id); };

      function toast(msg) {
        $("toastText").textContent = msg;
        $("toast").setAttribute("display", "inline");
        clearTimeout(window._tt);
        window._tt = setTimeout(function() { $("toast").setAttribute("display", "none"); }, 1800);
      }

      function setDock(tab) {
        var pos = { home: 8, calc: 94, diary: 180, saved: 264 }[tab] || 8;
        $("dockPill").setAttribute("x", pos);
        ["Home", "Calc", "Diary", "Saved"].forEach(function(k) {
          var active = k.toLowerCase() === tab;
          var col = active ? "#ffffff" : "#9ab5a4";
          $("lbl" + k).setAttribute("fill", col);
          $("lbl" + k).setAttribute("font-weight", active ? "700" : "600");
          $("ico" + k).setAttribute("stroke", col);
          if (k === "Calc") $("icoCalc2").setAttribute("stroke", col);
        });
      }

      function updateCustomCalc() {
        var f = state.food;
        var k = Math.round(f.kcal * state.grams / 100);
        var p = (f.prot * state.grams / 100).toFixed(1);
        $("customResult").textContent = state.grams + " g = " + k + " kcal · " + p + " g protein";
      }

      function openFood(key) {
        var f = FOODS[key] || FOODS.banana;
        state.food = f;
        state.grams = 200;
        $("fdEmoji").textContent = f.emoji;
        $("fdName").textContent = f.name;
        $("fdAlias").textContent = f.alias;
        $("fdKcal").textContent = f.kcal;
        $("fdProt").textContent = f.prot + " g";
        $("fdCarb").textContent = f.carb + " g";
        $("fdRow1").textContent = f.r1;
        $("fdRow2").textContent = f.r2;
        $("fdRow3").textContent = f.r3;
        $("fdRow4").textContent = f.r4;
        $("posterTitle").textContent = f.name;
        $("posterKcal").textContent = f.kcal;
        $("whyTitle").textContent = f.name + " kyun khayein?";
        $("whySummary").textContent = f.whyS;
        $("whyGood1").textContent = f.whyG;
        $("whyBad").textContent = f.whyB;
        updateCustomCalc();

        $("viewHome").setAttribute("display", "none");
        $("viewTool").setAttribute("display", "none");
        $("viewFoodDetail").setAttribute("display", "inline");
        $("topBackWrap").setAttribute("display", "inline");
      }

      function openTool(key, dockTab) {
        var t = TOOLS[key];
        if (!t) return;
        $("toolBadge").textContent = t.badge;
        $("toolTitle").textContent = t.title;
        $("toolSub").textContent = t.sub;
        $("tStat1").textContent = t.s1; $("tLbl1").textContent = t.l1;
        $("tStat2").textContent = t.s2; $("tLbl2").textContent = t.l2;
        $("tStat3").textContent = t.s3; $("tLbl3").textContent = t.l3;
        $("tRow1Title").textContent = t.r1t; $("tRow1Sub").textContent = t.r1s;
        $("tRow2Title").textContent = t.r2t; $("tRow2Sub").textContent = t.r2s;
        $("tRow3Title").textContent = t.r3t; $("tRow3Sub").textContent = t.r3s;
        $("toolCtaLabel").textContent = t.cta;
        $("waterBar").setAttribute("display", t.water ? "inline" : "none");

        $("viewHome").setAttribute("display", "none");
        $("viewFoodDetail").setAttribute("display", "none");
        $("viewTool").setAttribute("display", "inline");
        $("topBackWrap").setAttribute("display", "inline");
        if (dockTab) setDock(dockTab);
      }

      function goHome() {
        $("viewFoodDetail").setAttribute("display", "none");
        $("viewTool").setAttribute("display", "none");
        $("topBackWrap").setAttribute("display", "none");
        $("viewHome").setAttribute("display", "inline");
        setDock("home");
      }

