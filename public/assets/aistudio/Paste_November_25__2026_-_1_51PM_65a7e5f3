      @keyframes ringFill {
        0% { stroke-dashoffset: 208; }
        100% { stroke-dashoffset: 58; }
      }
      @keyframes blinkCursor {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
