      .glow-orb { animation: pulseGlow 4.5s ease-in-out infinite; }
      .ring-progress { stroke-dasharray: 208; stroke-dashoffset: 58; animation: ringFill 1.3s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both; }
