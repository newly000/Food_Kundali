        compare:   { badge: "FOOD COMPARISON", title: "Paneer vs Egg", sub: "Per 100 g · Green = highest nutrient", s1: "18.3 vs 12.6", l1: "Protein (g)", s2: "480 vs 50", l2: "Calcium (mg)", s3: "265 vs 155", l3: "Calories", r1t: "Protein: Paneer wins (18.3 g vs 12.6 g)", r1s: "Vegetarians ke liye dense protein source", r2t: "Calcium: Paneer wins (480 mg vs 50 mg)", r2s: "Hadiyon aur daanton ke liye ~9x zyada", r3t: "Vitamin B12: Egg wins (1.11 µg vs 0.52 µg)", r3s: "Nerves aur energy ke liye Egg aage hai", cta: "Doosra food compare karo", water: false },
